let obs=null,pw=0;
async function build(restore,my){
 if(obs)obs.disconnect();pagesEl.innerHTML='';
 const p1=await pdf.getPage(1),v1=p1.getViewport({scale:1});
 if(my!==token)return;
 pw=Math.round(scroller.clientWidth*zoom);const ratio=v1.height/v1.width;
