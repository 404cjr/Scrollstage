 }catch(e){el._d=0}
}

/* ---------- autoscroll & countdown ---------- */
let last=0,pos=0,expect=0,hold=false,holdT,raf=0,lock=null;
/* Speeds up the scroll while the reading line crosses the gap between two pages,
   easing in and out so it never jolts. */
function pbMult(){
 if(!pbOn||pbAmt<=1)return 1;
 const pg=pagesEl.children;if(pg.length<2)return 1;
 const zone=Math.max(40,pg[0].offsetHeight*0.06);   // reach of the boost on each side of a page edge
 const y=scroller.scrollTop+scroller.clientHeight*0.5; // reading line, middle of the screen
 let m=1;
 for(let i=1;i<pg.length;i++){
  const d=Math.abs(y-pg[i].offsetTop)/zone;
  if(d<1){const s=1-d,k=s*s*(3-2*s);m=Math.max(m,1+(pbAmt-1)*k)}
 }
 return m;
}
/* Speed brackets: inside a bracket the scroll runs at that bracket's multiplier.
   The multiplier eases toward its target so changes never jolt. */
let secCur=1;
function secTarget(){
 if(!cur||!cur.zones||!cur.zones.length)return 1;
 const f=(scroller.scrollTop+scroller.clientHeight*0.5)/(scroller.scrollHeight||1);
 let m=1;for(const z of cur.zones){if(f>=z.a&&f<=z.b)m=z.m}
 return m;
}
function secMult(dt){const t=secTarget();secCur+=(t-secCur)*Math.min(1,dt*5);return secCur}
function tick(t){
 if(!playing)return;
 const dt=Math.min(.05,(t-last)/1000);last=t;
 if(!hold){
  if(Math.abs(scroller.scrollTop-expect)>2)pos=scroller.scrollTop;
  pos+=spd()*pbMult()*secMult(dt)*dt;
  const max=scroller.scrollHeight-scroller.clientHeight;
  if(pos>=max){scroller.scrollTop=max;setPlaying(false);return}
  scroller.scrollTop=pos;expect=scroller.scrollTop;
 }
 raf=requestAnimationFrame(tick);
}

function startCountdown(cb) {
  let count = 3;
  const cdOverlay = $('#cd-overlay');
  const cdNum = $('#cd-num');
  cdNum.textContent = count;
  cdOverlay.classList.add('active');
  
  clearInterval(cdTimer);
  cdTimer = setInterval(() => {
    count--;
    if (count > 0) {
      cdNum.textContent = count;
    } else {
      clearInterval(cdTimer);
      cdOverlay.classList.remove('active');
      cb();
    }
  }, 1000);
}

async function setPlaying(p){
 if(p&&!pdf){toast('Open a PDF first.');return}
