 obs=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)renderPage(e.target,my)}),{root:scroller,rootMargin:'150% 0px'});
 [...pagesEl.children].forEach(c=>obs.observe(c));
 scroller.scrollTop=typeof restore==='number'?restore:0;pos=scroller.scrollTop;expect=pos;
 renderZones();
}
async function renderPage(el,my){
 if(el._d)return;el._d=1;
 try{
  const pg=await pdf.getPage(+el.dataset.n);if(my!==token)return;
  const b=pg.getViewport({scale:1}),css=pw/b.width;
  let sc=css*Math.min(devicePixelRatio||1,2);const px=b.width*b.height*sc*sc;if(px>14e6)sc*=Math.sqrt(14e6/px);
  const vp=pg.getViewport({scale:sc});
  const c=document.createElement('canvas');c.width=Math.floor(vp.width);c.height=Math.floor(vp.height);
  c.style.width=pw+'px';c.style.height=Math.round(b.height*css)+'px';
  el.style.height=c.style.height;schedZones();
  await pg.render({canvasContext:c.getContext('2d'),viewport:vp}).promise;
