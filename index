 });
}

function dragZone(z,kind,e,el){
 e.preventDefault();
 const tgt=e.currentTarget;try{tgt.setPointerCapture(e.pointerId)}catch(x){}
 const H0=zoneH(),minF=MIN_ZONE_PX/H0,y0=e.clientY,a0=z.a,b0=z.b,s0=scroller.scrollTop;
 let cy=e.clientY,moved=false,rafE=0;
 const apply=()=>{
  const df=((cy-y0)+(scroller.scrollTop-s0))/H0,len=b0-a0;
  if(kind==='top')z.a=Math.max(0,Math.min(z.b-minF,a0+df));
  else if(kind==='bot')z.b=Math.min(1,Math.max(z.a+minF,b0+df));
  else{const na=Math.max(0,Math.min(1-len,a0+df));z.a=na;z.b=na+len}
  placeZone(el,z);
 };
 const edge=()=>{ // scroll the page when a handle is dragged near the top or bottom of the screen
  const r=scroller.getBoundingClientRect();
  if(cy<r.top+50)scroller.scrollTop-=10;else if(cy>r.bottom-50)scroller.scrollTop+=10;
  apply();rafE=requestAnimationFrame(edge);
 };
 const mv=ev=>{cy=ev.clientY;if(Math.abs(cy-y0)>4)moved=true;apply()};
 const up=()=>{
  tgt.removeEventListener('pointermove',mv);tgt.removeEventListener('pointerup',up);tgt.removeEventListener('pointercancel',up);
  cancelAnimationFrame(rafE);
  z.a=+z.a.toFixed(5);z.b=+z.b.toFixed(5);
  if(kind==='move'&&!moved&&selZone===z)selZone=null;else selZone=z;
  cur.zones.sort((p,q)=>p.a-q.a);
  commitZones();
 };
 tgt.addEventListener('pointermove',mv);tgt.addEventListener('pointerup',up);tgt.addEventListener('pointercancel',up);
 rafE=requestAnimationFrame(edge);
}

$('#zadd').onclick=()=>{
 if(!cur){toast('Open a PDF first.');return}
 const H=zoneH(),len=Math.min(.5,Math.max(MIN_ZONE_PX/H,scroller.clientHeight*0.4/H));
 const mid=(scroller.scrollTop+scroller.clientHeight*0.5)/H;
 let a=Math.max(0,Math.min(1-len,mid-len/2));
 const zs=cur.zones||[];
 for(let i=0;i<zs.length;i++){const k=zs[i];if(a<k.b&&a+len>k.a){a=k.b+.004;i=-1}} // slide past any bracket already here
 if(a+len>1){toast('No room here. Scroll to another part of the song.');return}
 const z={a:+a.toFixed(5),b:+(a+len).toFixed(5),m:1.5};
 (cur.zones||(cur.zones=[])).push(z);cur.zones.sort((p,q)=>p.a-q.a);
 selZone=z;commitZones();
};
scroller.addEventListener('pointerdown',e=>{if(selZone&&!(e.target.closest&&e.target.closest('.zb'))){selZone=null;renderZones()}});

/* ---------- keys & Bluetooth Foot Pedal controls ---------- */
addEventListener('keydown',e=>{
 if(e.target.closest&&e.target.closest('input,textarea,.vs'))return;
 if(e.code==='Space'){e.preventDefault();setPlaying(!playing)}
 else if(e.key==='PageDown'||(e.key==='ArrowRight'&&!e.shiftKey)){
   e.preventDefault();
   scroller.scrollTop += scroller.clientHeight * 0.85;
   pos = scroller.scrollTop; expect = pos;
 }
 else if(e.key==='PageUp'||(e.key==='ArrowLeft'&&!e.shiftKey)){
   e.preventDefault();
   scroller.scrollTop -= scroller.clientHeight * 0.85;
   pos = scroller.scrollTop; expect = pos;
 }
 else if(e.key==='ArrowUp'&&e.shiftKey){nudge(5)}
 else if(e.key==='ArrowDown'&&e.shiftKey){nudge(-5)}
 else if(e.key==='Home'){$('#top').click()}
});

/* ---------- boot ---------- */
(async()=>{
 syncUnits();setSpeed(mode==='bpm'?bpm:speed,true);
 updateFolderSelect();
 songs=await store.all();
 songs.sort((a,b)=>(a.added||0)-(b.added||0));
 renderList();
 if(narrow()&&songs.length)setLib(false);
 lw=scroller.clientWidth;
})();
})();
</script>
