/* ---------- library & reordering ---------- */
function moveSong(visIdx, dir) {
  const visibleSongs = getVisibleSongs();
  if (visIdx + dir < 0 || visIdx + dir >= visibleSongs.length) return;
  
  const s1 = visibleSongs[visIdx];
  const s2 = visibleSongs[visIdx + dir];
  
  const t = s1.added;
  s1.added = s2.added;
  s2.added = t;
  
  store.put(s1); store.put(s2);
  songs.sort((a,b)=>(a.added||0)-(b.added||0));
  renderList();
}

